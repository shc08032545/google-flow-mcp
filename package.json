{
  "name": "google-flow-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Google Flow Web (Chrome CDP) and Gemini Omni 1.1/1.2 Flash API video generation with Storyboard 2x2 splitter",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-flow-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "jimp": "^1.6.0",
    "playwright-core": "^1.51.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
