# Default backend: "cdp" (Google Flow Web via Chrome CDP) or "api" (Gemini Omni Flash Interactions API)
FLOW_DEFAULT_BACKEND=cdp

# Chrome DevTools Protocol URL (for Google Flow Web mode)
CHROME_CDP_URL=http://127.0.0.1:9222
FLOW_URL_MATCH=flow.google.com

# Google AI Studio API Key (for Gemini Omni 1.1 / 1.2 Flash API mode)
GOOGLE_API_KEY=

# Default Omni model ID: gemini-omni-1.1-flash | gemini-omni-1.2-flash
OMNI_DEFAULT_MODEL=gemini-omni-1.1-flash

# Optional custom DOM selectors override for flow.google.com
FLOW_SELECTORS_PATH=./selectors.json

# Default directory for generated videos & cropped storyboard frames
FLOW_OUTPUT_DIR=./outputs
