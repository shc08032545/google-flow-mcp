{
  "promptInput": [
    "textarea[placeholder*=\"Describe\" i]",
    "textarea[placeholder*=\"Generate\" i]",
    "textarea[placeholder*=\"Prompt\" i]",
    "div[contenteditable=\"true\"][role=\"textbox\"]",
    "textarea"
  ],
  "generateButton": [
    "button[aria-label*=\"Generate\" i]",
    "button[aria-label*=\"Create\" i]",
    "button[aria-label*=\"Send\" i]",
    "button:has-text(\"Generate\")",
    "button[type=\"submit\"]"
  ],
  "fileInput": [
    "input[type=\"file\"]"
  ],
  "attachButton": [
    "button[aria-label*=\"Add\" i]",
    "button[aria-label*=\"Upload\" i]",
    "button[aria-label*=\"Ingredient\" i]",
    "button[aria-label*=\"Frame\" i]",
    "button[aria-label*=\"Image\" i]"
  ],
  "modelSelector": [
    "button[aria-label*=\"Model\" i]",
    "button:has-text(\"Omni\")",
    "button:has-text(\"Veo\")",
    "[role=\"combobox\"][aria-label*=\"Model\" i]"
  ],
  "durationSelector": [
    "button[aria-label*=\"Duration\" i]",
    "button:has-text(\"10s\")",
    "button:has-text(\"8s\")",
    "button:has-text(\"5s\")"
  ],
  "aspectRatioSelector": [
    "button[aria-label*=\"Aspect\" i]",
    "button:has-text(\"9:16\")",
    "button:has-text(\"16:9\")",
    "button:has-text(\"Portrait\")"
  ],
  "videoElement": [
    "video[src]",
    "video source[src]",
    "video"
  ],
  "downloadButton": [
    "button[aria-label*=\"Download\" i]",
    "a[download]"
  ]
}
